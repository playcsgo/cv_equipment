<div class="container d-flex flex-column">
  {{!-- top --}}
  <div class="row d-flex justify-content-around my-3">
    {{!-- left half --}}
    <div class="col-md-5 my-5">
      <form action="/topup"  method="POST" class="form-group my-2">
        <label for="top-up">Top up here (1-50000)</label>
        <input type="number" name="amount" id="top-up" min="1" max="50000" step="1" class="form-control my-2" required>
        <input type="hidden" name="topupId" value="{{ topupId }}">
        <button class="btn btn-topup my-2" type="submit">
          Top up!
        </button>
      </form>
      <div class="my-5">
        <h3 class="balance align-items-center ">
          <i class="fa-regular fa-gem"></i> {{ user.currency }}
        </h3>
        {{#if pendingTopups.length}}
          <p class="pending-note" data-pending-topups="{{ pendingTopupIds }}">
            <i class="fa-solid fa-spinner fa-spin"></i> 儲值處理中：{{#each pendingTopups}}+{{ this.amount }} {{/each}}
          </p>
        {{/if}}
        {{#if awaitingGear}}
          <p class="pending-note" data-awaiting-gear="{{ awaitingGear }}">
            <i class="fa-solid fa-spinner fa-spin"></i> 升級處理中…
          </p>
        {{/if}}
      </div>
      <div class="gear-panel">
        <p class="gear-hint">
          <i class="fa-solid fa-hand-pointer"></i>
          Click a gear below to upgrade it (💎 {{ game.LEVEL_UP_COST }} each, max Lv {{ game.MAX_LEVEL }})
        </p>
        {{> gearButton slot="helmet_lv" name="Helmet" icon="fa-helmet-safety" lv=user.helmet_lv currency=user.currency}}
        {{> gearButton slot="armor_lv" name="Armor" icon="fa-shield-halved" lv=user.armor_lv currency=user.currency}}
        {{> gearButton slot="weapon_lv" name="Weapon" icon="fa-hand-back-fist" lv=user.weapon_lv currency=user.currency}}
        <form action="/gearup/reset" method="POST" class="gear-form">
          <button type="submit" class="gear-btn gear-btn-reset">
            <i class="fa-solid fa-feather-pointed gear-icon"></i>
            <span class="gear-name">Reset</span>
            <span class="gear-action">All to Lv 1</span>
          </button>
        </form>
      </div>
    </div>
    {{!-- right half --}}
    <div class="col-md-5 my-5">
      <div class="relative-container">
        <div class="puppet">
        <img src="/image/puppet.png" alt=""
        style="width: 500px; height: 500px;">
      </div>
      <div class="helmet">
        <img src="/image/helmet_{{ user.helmet_lv }}.png" alt=""
        style="width: 200px; height: 200px; opacity: 0.9; z-index: 3; position: relative;">
      </div>
      <div class="armor">
        <img src="/image/armor_{{ user.armor_lv }}.png" alt=""
        style="width: 300px; height: 300px; opacity: 0.9; z-index: 3; position: relative;">
      </div>
      <div class="weapon">
        <img src="/image/weapon_{{ user.weapon_lv }}.png" alt=""
        style="width: 200px; height: 200px; opacity: 0.9; z-index: 3; position: relative;">
      </div>
    </div>
      </div>
  </div>
  {{!-- bottom --}}
  <div class="my-5" id="logContainer"></div>
</div>

<script>
  (() => {
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
    const getJSON = (url) => fetch(url).then((r) => (r.ok ? r.json() : null)).catch(() => null)

    // 儲值：每 0.5 秒查一次每筆儲值的狀態，全部 done 就重新整理（最多等 60 秒）
    const topupEl = document.querySelector('[data-pending-topups]')
    if (topupEl) {
      const ids = topupEl.dataset.pendingTopups.split(' ').filter(Boolean)
      ;(async () => {
        for (let i = 0; i < 120; i++) {
          await sleep(500)
          const results = await Promise.all(ids.map((id) => getJSON(`/topup/${id}`)))
          if (results.every((r) => r && r.status === 'done')) return location.reload()
        }
      })()
    }

    const gearEl = document.querySelector('[data-awaiting-gear]')
    if (!gearEl && location.search.includes('gearFrom')) {
      history.replaceState(null, '', '/') // 已經處理完了：清掉網址上的 ?gearFrom
    }
    if (gearEl) {
      const before = gearEl.dataset.awaitingGear
      ;(async () => {
        for (let i = 0; i < 10; i++) {
          await sleep(500)
          const s = await getJSON('/state')
          if (s && `${s.currency}-${s.helmet_lv}-${s.armor_lv}-${s.weapon_lv}` !== before) break
        }
        location.replace('/')
      })()
    }
  })()
</script>